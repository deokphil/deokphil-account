# 로컬 개발 시에는 이 값을 그대로 사용해도 됩니다.
# Render 배포 시에는 Neon/Supabase에서 발급받은 Postgres 연결 문자열로 교체합니다.
DATABASE_URL=sqlite:///./deokphil.db

# JWT 서명용 비밀키 (배포 전에 반드시 무작위 문자열로 교체하세요)
SECRET_KEY=change-this-to-a-random-secret-key

APP_NAME=덕필 계좌 관리 시스템

# 서버 최초 실행 시 이 아이디/비밀번호로 수퍼유저 계정이 자동 생성됩니다.
# 계정이 이미 있으면 무시되니, 실제 운영 전에는 반드시 비밀번호를 바꾸세요.
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=changeme123
